# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external backend URL when hosting frontend separately
# VITE_API_BASE_URL="https://your-backend-service.run.app"

# PostgreSQL Connection String (on Vercel, use a Pooler URL: Neon -pooler or Supabase port 6543)
# DATABASE_URL="postgresql://user:password@host:6543/dbname?sslmode=require&pgbouncer=true"
# Optional SSL overrides (certificate verification is enabled by default in production)
# DB_SSL_REJECT_UNAUTHORIZED="true"
# DB_SSL_CA=""

# Cloud SQL PostgreSQL Runtime Variables (injected automatically in AI Studio Cloud Run)
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Standard Vercel / Supabase / Neon PostgreSQL Discrete Variables (optional alternative to DATABASE_URL)
# POSTGRES_HOST=""
# POSTGRES_PORT="5432"
# POSTGRES_USER=""
# POSTGRES_PASSWORD=""
# POSTGRES_DATABASE=""

# JWT Signing Secrets
# IMPORTANT: In production (NODE_ENV=production or Vercel), BOTH secrets are required,
# must be at least 32 characters long, must be different from each other, and cannot use these example values.
# Generate two separate strong 64-char hex secrets with:
#   openssl rand -hex 32
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-strong-secret-in-production"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret-in-production"
