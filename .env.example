# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Runtime Variables (injected automatically in AI Studio Cloud Run)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# JWT Signing Secrets (set strong random secrets in production)
JWT_SECRET="replace-with-strong-secret-in-production"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret-in-production"
