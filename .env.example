# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external backend URL when hosting frontend separately
# VITE_API_BASE_URL="https://your-backend-service.run.app"

# PostgreSQL Connection String (recommended for Vercel / Neon / Supabase / external hosting)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Cloud SQL PostgreSQL Runtime Variables (injected automatically in AI Studio Cloud Run)
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# JWT Signing Secrets (set strong random secrets in production)
JWT_SECRET="replace-with-strong-secret-in-production"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret-in-production"
